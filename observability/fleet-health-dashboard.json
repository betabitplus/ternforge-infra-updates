{
  "uid": "ternforge-fleet-health",
  "title": "Ternforge Fleet Health",
  "tags": ["ternforge", "fleet-health"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Overall critical state",
      "description": "0 = healthy, 1 = at least one critical Fleet Health invariant is unhealthy. This is a worst-state signal, not a weighted score.",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "max((1 - last_over_time(ternforge_update_run_success{ternforge_trigger=\"release\"}[14d])) or (last_over_time(ternforge_fleet_expected_repositories{ternforge_trigger=\"release\"}[14d]) != bool last_over_time(ternforge_fleet_observed_repositories{ternforge_trigger=\"release\"}[14d])) or (1 - last_over_time(ternforge_fleet_token_scope_ok{ternforge_trigger=\"release\"}[14d])) or ((time() - last_over_time(ternforge_update_last_success_unixtime[48h])) > bool 129600) or (last_over_time(ternforge_update_processing_duration_seconds{ternforge_trigger=\"release\"}[14d]) > bool 2700))", "instant": true}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Healthy"}, "1": {"text": "Critical"}}}]}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Delivery reliability",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{"refId": "A", "expr": "last_over_time(ternforge_update_run_success{ternforge_trigger=\"release\"}[14d])", "instant": true}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Failed"}, "1": {"text": "Success"}}}]}, "overrides": []}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Delivery latency",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "last_over_time(ternforge_update_processing_duration_seconds{ternforge_trigger=\"release\"}[14d])", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Recovery freshness",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [{"refId": "A", "expr": "time() - last_over_time(ternforge_update_last_success_unixtime[48h])", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fleet coverage",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 5},
      "targets": [
        {"refId": "A", "expr": "last_over_time(ternforge_fleet_expected_repositories{ternforge_trigger=\"release\"}[14d])", "instant": true, "legendFormat": "expected"},
        {"refId": "B", "expr": "last_over_time(ternforge_fleet_observed_repositories{ternforge_trigger=\"release\"}[14d])", "instant": true, "legendFormat": "observed"},
        {"refId": "C", "expr": "last_over_time(ternforge_fleet_token_scope_ok{ternforge_trigger=\"release\"}[14d])", "instant": true, "legendFormat": "token scope"}
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Update adoption: open Renovate PRs",
      "datasource": {"type": "grafana-github-datasource", "uid": "ternforge-github"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 5},
      "targets": [{"refId": "A", "queryType": "Pull_Requests", "owner": "betabitplus", "repository": "", "options": {"query": "is:open author:app/renovate", "timeField": 4}}]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Configuration health: Renovate warnings",
      "datasource": {"type": "grafana-github-datasource", "uid": "ternforge-github"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5},
      "targets": [{"refId": "A", "queryType": "Issues", "owner": "betabitplus", "repository": "", "options": {"query": "is:open label:renovate/config-error", "timeField": 2}}]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Capacity: active OTLP series",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 13},
      "targets": [{"refId": "A", "expr": "grafanacloud_instance_active_otlp_series", "instant": true}]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Capacity: included DPM / series",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 13},
      "targets": [{"refId": "A", "expr": "grafanacloud_org_metrics_included_dpm_per_series", "instant": true}]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Native full-fleet workflow runs",
      "datasource": {"type": "grafana-github-datasource", "uid": "ternforge-github"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 13},
      "targets": [{"refId": "A", "queryType": "Workflow_Runs", "owner": "betabitplus", "repository": "ternforge-infra-updates", "options": {"workflow": "reconcile.yml", "branch": "main"}}]
    }
  ]
}
